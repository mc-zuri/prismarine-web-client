@@ -145,6 +145,15 @@ const entityReplicator = (bot) => {
             for (const [id, entity] of Object.entries(bot.entities)) {
                 const entityPackets = getAllEntityPackets(id);
                 for (const [packetType, packet] of entityPackets) {
+                    if (packet === entityPackets[0][1] && 'x' in packet) {
+                        // the position mineflayer tracked (the relative moves above are fixed-point, and nested in steps from 26.1)
+                        const pos = entity.position;
+                        if (pos && Number.isFinite(pos.x) && Number.isFinite(pos.y) && Number.isFinite(pos.z)) {
